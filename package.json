{
        "name": "nhentai-bot-vercel",
        "version": "2.0.0",
        "description": "Bilingual (fa/en) nhentai Telegram bot designed for Vercel serverless — webhook-based, Turso (libSQL) storage, nhentai API v2.",
        "type": "module",
        "engines": {
                "node": ">=20"
        },
        "license": "GPL-3.0",
        "scripts": {
                "dev": "tsx src/dev.ts",
                "webhook:set": "node scripts/set-webhook.mjs",
                "webhook:delete": "node scripts/delete-webhook.mjs",
                "db:init": "node scripts/db-init.mjs",
                "typecheck": "tsc --noEmit",
                "smoke": "tsx scripts/smoke.ts",
                "test": "npm run smoke && npx tsx scripts/integration.ts"
        },
        "dependencies": {
                "@libsql/client": "^0.15.10",
                "@vercel/functions": "^3.2.1",
                "dotenv": "^17.3.1",
                "drizzle-orm": "^0.44.6",
                "grammy": "^1.40.0"
        },
        "devDependencies": {
                "@types/node": "^24.10.1",
                "tsx": "^4.20.6",
                "typescript": "^5.9.3"
        }
}
