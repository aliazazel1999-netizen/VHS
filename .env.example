# ─────────────────────────────────────────────────────────────
#  nhentai-bot-vercel — environment variables
#  کپی این فایل به ‎.env برای اجرای محلی، یا در داشبورد Vercel تنظیم کن
# ─────────────────────────────────────────────────────────────

# [required] توکن ربات از @BotFather
BOT_TOKEN=123456:ABC-DEF...

# [required] کلید API از nhentai.net — از بخش Account Settings → API Keys
# https://nhentai.net/user/settings#apikeys
NHENTAI_API_KEY=

# [required در تولید] اتصال Turso (libSQL):
#   turso db show --url <db-name>  →  آدرس دیتابیس
TURSO_DATABASE_URL=libsql://your-db-your-org.turso.io
#   turso db tokens create         →  توکن دیتابیس
TURSO_AUTH_TOKEN=
# برای اجرای محلی می‌توانی به‌جای موارد بالا از فایل SQLite محلی استفاده کنی:
# TURSO_DATABASE_URL=file:local.db
# TURSO_AUTH_TOKEN=

# [recommended] راز وب‌هوک — یک رشته تصادفی بلند (تلگرام در هدر X-Telegram-Bot-Api-Secret-Token می‌فرستدش)
WEBHOOK_SECRET=change-me-to-a-long-random-string

# [برای webhook:set] آدرس دیپلوی روی ورسل (بعد از اولین دیپلوی)
APP_URL=https://your-project.vercel.app

# ── اختیاری ──────────────────────────────────────────────────

# زبان پیش‌فرض کاربر جدید: auto (تشخیص از زبان تلگرام) / fa / en
DEFAULT_LANGUAGE=auto

# سقف حجم فایل ZIP که ربات خودش آپلود می‌کند (مگابایت) — بزرگ‌تر از این، لینک دانلود می‌دهد
# سقف آپلود Bot API تلگرام ۵۰ مگابایت است؛ بیشتر از ۴۵ تنظیم نکن
ZIP_MAX_MB=45

# سقف زمان دانلود آرشیو در دستور /zip (میلی‌ثانیه) — باید کمتر از maxDuration ورسل باشد
ZIP_TIMEOUT_MS=45000

# آدرس FlareSolverr اگر nhentai درخواست‌های سرورت را با Cloudflare مسدود کرد (اختیاری)
# مثال: http://127.0.0.1:8191  — روی ورسل باید روی سرور جدا (مثلاً VPS) اجرایش کنی
FLARESOLVERR_URL=

# سقف زمان درخواست به FlareSolverr (میلی‌ثانیه)
SOURCE_MAX_TIMEOUT_MS=60000

# User-Agent که به nhentai ارسال می‌شود (طبق درخواست مستندات API باید توصیفی باشد)
NHENTAI_USER_AGENT=nhentai-telegram-bot/2.0 (+https://github.com/sleroq/nhentai-telegram-bot)
